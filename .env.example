# Secreto para firmar JWTs. Obligatorio: el server no arranca sin esto.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto del servidor. Railway lo inyecta automáticamente, no hace falta setearlo ahí.
PORT=3001

# String de conexión a Postgres (Railway la provee como ${{Postgres.DATABASE_URL}}).
# Si se deja vacío, el server usa SQLite local (./agencyos.db) — comportamiento de desarrollo.
DATABASE_URL=

# Poner en "true" si la conexión a Postgres requiere SSL (ej: conexión externa a Railway).
# No es necesaria para la red privada interna de Railway.
DB_SSL=

# Orígenes permitidos para CORS, separados por coma (ej: https://miapp.up.railway.app).
# Vacío = permite cualquier origen (comportamiento de desarrollo).
CORS_ORIGIN=

# Carpeta donde se guardan los archivos subidos (videos, adjuntos).
# En Railway, montar un Volume y apuntar esta variable a su path para persistencia.
# Vacío = ./uploads (relativo al proyecto).
UPLOAD_DIR=
