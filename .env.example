# Secreto para firmar JWTs. Obligatorio: el server no arranca sin esto.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Puerto del servidor. Render lo inyecta automáticamente, no hace falta setearlo ahí.
PORT=3001

# String de conexión a Postgres (ej: Supabase, connection pooling "Session pooler" — Render
# no soporta IPv6 saliente, así que la conexión "Direct" de Supabase, que usa IPv6, no sirve acá).
# Si se deja vacío, el server usa SQLite local (./agencyos.db) — comportamiento de desarrollo.
DATABASE_URL=

# Poner en "true" si la conexión a Postgres requiere SSL (ej: Supabase u otro Postgres externo).
DB_SSL=

# Orígenes permitidos para CORS, separados por coma (ej: https://miapp.onrender.com).
# Vacío = permite cualquier origen (comportamiento de desarrollo).
CORS_ORIGIN=

# ─── Storage de archivos (videos, adjuntos) ─────────────────────────────────────
# Con las 4 variables R2_* configuradas, el server sube/sirve/borra todo en Cloudflare R2
# (necesario en Render: no hay disco persistente compartido entre instancias, y R2 no cobra
# egress). Si se dejan vacías, cae a disco local en UPLOAD_DIR — comportamiento de desarrollo.

# Account ID de Cloudflare (Dashboard → R2 Object Storage → Account Details).
R2_ACCOUNT_ID=

# Access Key ID y Secret Access Key de un API token de R2 con permiso "Object Read & Write"
# limitado al bucket de esta app (Dashboard → R2 Object Storage → Manage API Tokens).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket (ej: agencyos-uploads).
R2_BUCKET=

# Solo se usa en desarrollo local (sin las variables R2_* de arriba configuradas): carpeta donde
# se guardan los archivos subidos. Vacío = ./uploads (relativo al proyecto).
UPLOAD_DIR=

# Límite duro de almacenamiento en GB antes de rechazar subidas nuevas. Por defecto 25GB; bajalo
# a algo como 9 si usás el free tier de R2 (10GB) para tener margen de aviso antes del límite real.
STORAGE_LIMIT_GB=
